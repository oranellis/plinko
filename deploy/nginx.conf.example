# One server block per tenant, each to the port its process listens on. TLS is ended here, so the
# server's session cookie is Secure. Host must be passed on, the server checks it against Origin.
server {
    listen 443 ssl;
    server_name acme.plinko.example.com;
    ssl_certificate     /etc/letsencrypt/live/plinko.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/plinko.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 1h;
    }
}
